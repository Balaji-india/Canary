# Copy this file to .env (never commit .env; it is in .gitignore) and fill in only the keys you use.
# Canary runs on Ollama alone without any key. Cloud keys are read by their NAME (config/models.yaml, key_env).
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# Groq free plan, ceiling check arm L (console.groq.com -> API Keys). No payment method on the account.
GROQ_API_KEY=
# Gemini API free tier, arm R only if arm L is not SOLVABLE (aistudio.google.com/apikey, project without billing).
GEMINI_API_KEY=
# Azure for Students, arm R backup only (untested; see the commented azure entry in config/models.yaml).
AZURE_OPENAI_API_KEY=
